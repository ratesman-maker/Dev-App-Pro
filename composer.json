{
    "name": "devapp/devapppro",
    "description": "Dev App Pro - lokální business-management SaaS",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "mpdf/mpdf": "^8.3",
        "mpdf/qrcode": "^1.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "DevAppPro\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "DevAppPro\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
